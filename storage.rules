rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && ('admin' in request.auth.token) && request.auth.token.admin == true;
    }

    function isActiveAdminUser() {
      return signedIn()
        && isActiveAdminUserProfile(request.auth.uid, request.auth.token.get('admin', false) == true);
    }

    function isActiveAdminUserProfile(userId, tokenIsAdmin) {
      let userPath = /databases/(default)/documents/users/$(userId);
      let userExists = firestore.exists(userPath);
      let profile = userExists ? firestore.get(userPath).data : {};
      return userExists
        ? isActiveAdminProfile(profile)
        : tokenIsAdmin;
    }

    function isActiveAdminProfile(profile) {
      let assignments = profile.get('adminRoles', []);
      let expiresAt = profile.get('adminAccessExpiresAt', null);
      return (request.auth.token.get('admin', false) == true
          || profile.get('isAdmin', false) == true
          || profile.get('adminRole', '') == 'admin'
          || (assignments is list && assignments.hasAny([
            'admin', 'platform_owner', 'super_admin', 'operations_admin',
            'finance_admin', 'moderation_admin', 'safety_admin', 'support_admin',
            'sponsor_manager', 'event_tournament_admin', 'content_admin',
            'marketing_communications_admin', 'analyst', 'read_only_auditor',
            'technical_admin', 'developer_support'
          ])))
        && profile.get('adminAccessStatus', 'legacy_active') in ['active', 'legacy_active']
        && profile.get('adminSecuritySetupComplete', true) != false
        && (expiresAt == null
          || (expiresAt is timestamp && request.time < expiresAt)
          || (expiresAt is int && request.time.toMillis() < expiresAt));
    }

    function isChallengeManager(challengeId) {
      let challengePath = /databases/(default)/documents/challenges/$(challengeId);
      let challengeExists = firestore.exists(challengePath);
      let challenge = challengeExists ? firestore.get(challengePath).data : {};
      return signedIn()
        && (isAdmin()
          || (challengeExists
            && challenge.get('officialChallenge', false) != true
            && challenge.get('ownershipType', '') != 'challenge_suite_official'
            && isChallengeOwner(challenge))
          || (challengeExists && isEnterpriseChallengeManager(challenge)));
    }

    function hasPrivateChallengeMarker(value) {
      return value is string && value.lower().matches('.*(private|exclusive|invite).*');
    }

    function isPrivateChallenge(challenge) {
      return hasPrivateChallengeMarker(challenge.get('visibility', ''))
        || hasPrivateChallengeMarker(challenge.get('type', ''));
    }

    function hasPrivateChallengeMediaAccess(challengeId) {
      let accessPath = /databases/(default)/documents/challengeMediaAccess/$(challengeId + '_' + request.auth.uid);
      let accessExists = firestore.exists(accessPath);
      let access = accessExists ? firestore.get(accessPath).data : {};
      return signedIn() && accessExists
        && access.get('privateMediaRead', false) == true
        && access.get('status', '') == 'active';
    }

    function isChallengeOwner(challenge) {
      return signedIn()
        && (challenge.get('creatorId', '') == request.auth.uid
          || challenge.get('hostId', '') == request.auth.uid
          || challenge.get('ownerId', '') == request.auth.uid);
    }

    function isPublicPrivatePreview(challenge) {
      return challenge.get('visibility', '') == 'private'
        && challenge.get('publicPreviewEnabled', false) == true
        && challenge.get('publicVisibility', true) != false
        && challenge.get('eventVisibility', '') != 'hidden_until_approved'
        && challenge.get('status', challenge.get('lifecycleStatus', '')) in ['published', 'approved', 'scheduled', 'registration_open', 'active'];
    }

    function canReadChallengeMedia(challengeId) {
      let challengePath = /databases/(default)/documents/challenges/$(challengeId);
      let challengeExists = firestore.exists(challengePath);
      let challenge = challengeExists ? firestore.get(challengePath).data : {};
      return isAdmin()
        || (challengeExists && (
          isChallengeOwner(challenge)
          || (isPrivateChallenge(challenge)
            ? hasPrivateChallengeMediaAccess(challengeId)
            : isEnterpriseChallengeManager(challenge))));
    }

    function isEnterpriseChallengeManager(challenge) {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      let userExists = firestore.exists(userPath);
      let user = userExists ? firestore.get(userPath).data : {};
      let staff = user.get('staffAccess', {});
      return signedIn()
        && userExists
        && challenge.get('officialChallenge', false) == true
        && challenge.get('organizationOwnerId', '') is string
        && challenge.get('organizationOwnerId', '') != ''
        && staff.get('status', '') == 'active'
        && staff.get('organizationStatus', '') == 'active'
        && staff.get('organizationId', '') == challenge.get('organizationOwnerId', '')
        && staff.get('permissions', []) is list
        && staff.get('permissions', []).hasAny(['challenge.edit'])
        && (staff.get('expiresAtTimestamp', null) == null
          || (staff.get('expiresAtTimestamp', null) is timestamp && request.time < staff.get('expiresAtTimestamp', null)))
        && (staff.get('scope', '') == 'all_official'
          || (staff.get('scope', '') in ['assigned_only', 'read_all_edit_assigned']
            && challenge.get('enterpriseAssignedUserIds', []) is list
            && challenge.get('enterpriseAssignedUserIds', []).hasAny([request.auth.uid])));
    }

    function isStoredImage() {
      return resource != null
        && resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isPublicChallengeBanner(challengeId, fileName) {
      let challengePath = /databases/(default)/documents/challenges/$(challengeId);
      let path = 'challenges/' + challengeId + '/banner/' + fileName;
      let challenge = firestore.exists(challengePath) ? firestore.get(challengePath).data : {};
      let publicMediaPaths = challenge.get('publicMediaPaths', []);
      let isReferenced = challenge.get('coverImagePath', '') == path
        || (publicMediaPaths is list && publicMediaPaths.hasAny([path]));
      return isReferenced
        && !isPrivateChallenge(challenge)
        && challenge.get('visibility', 'public') == 'public'
        && challenge.get('publicVisibility', true) != false
        && challenge.get('eventVisibility', '') != 'hidden_until_approved'
        && challenge.get('status', challenge.get('lifecycleStatus', ''))
          in ['approved', 'published', 'scheduled', 'registration_open', 'active', 'submission_open', 'submission_closed', 'voting_open', 'voting_closed', 'under_review', 'winners_announced', 'completed'];
    }

    function isPublicPrivatePreviewBanner(challengeId, fileName) {
      let challengePath = /databases/(default)/documents/challenges/$(challengeId);
      let path = 'challenges/' + challengeId + '/banner/' + fileName;
      let challengeExists = firestore.exists(challengePath);
      let challenge = challengeExists ? firestore.get(challengePath).data : {};
      return challengeExists
        && isPrivateChallenge(challenge)
        && isPublicPrivatePreview(challenge)
        && challenge.get('coverImagePath', '') == path
        && isStoredImage();
    }

    function canReadVerifiedChallengeMedia(challengeId, mediaKind, fileName) {
      let challengePath = /databases/(default)/documents/challenges/$(challengeId);
      let path = 'verified-challenge-media/' + challengeId + '/' + mediaKind + '/' + fileName;
      let challengeExists = firestore.exists(challengePath);
      let challenge = challengeExists ? firestore.get(challengePath).data : {};
      let isCover = challenge.get('coverImagePath', '') == path;
      let publicMediaPaths = challenge.get('publicMediaPaths', []);
      let isExplicitlyPublic = publicMediaPaths is list && publicMediaPaths.hasAny([path]);
      let publicRecord = challenge.get('visibility', 'public') == 'public'
        && challenge.get('publicVisibility', true) != false
        && challenge.get('eventVisibility', '') != 'hidden_until_approved'
        && challenge.get('status', challenge.get('lifecycleStatus', ''))
          in ['approved', 'published', 'scheduled', 'registration_open', 'active', 'submission_open', 'submission_closed', 'voting_open', 'voting_closed', 'under_review', 'winners_announced', 'completed'];
      return challengeExists && (
        (publicRecord && !isPrivateChallenge(challenge) && mediaKind == 'images' && isStoredImage() && (isCover || isExplicitlyPublic))
        || (isPrivateChallenge(challenge) && isPublicPrivatePreview(challenge) && mediaKind == 'images' && isStoredImage() && isCover)
        || canReadChallengeMedia(challengeId));
    }

    function isImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isCreatorImage() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isVideo() {
      return request.resource != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType in ['video/mp4', 'video/avi', 'video/x-msvideo'];
    }

    function isDocument() {
      return request.resource != null
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'text/plain'
        ];
    }

    function canWriteChallengeDraftMedia(folder) {
      return (folder in ['banner', 'gallery'] && isCreatorImage())
        || (folder == 'video' && isVideo())
        || (folder == 'documents' && isDocument());
    }

    function canWriteTournamentDraftMedia(folder) {
      return (folder == 'cover' && isCreatorImage())
        || (folder == 'trailer' && isVideo());
    }

    function canReadSponsorConversation(conversationId) {
      let conversationPath = /databases/(default)/documents/sponsorConversations/$(conversationId);
      let conversationExists = firestore.exists(conversationPath);
      let conversation = conversationExists ? firestore.get(conversationPath).data : {};
      return isActiveAdminUser()
        || (signedIn()
          && conversationExists
          && (conversation.get('sponsorId', '') == request.auth.uid
            || conversation.get('recipientId', '') == request.auth.uid));
    }

    function canWriteSponsorConversation(conversationId, sponsorId) {
      let conversationPath = /databases/(default)/documents/sponsorConversations/$(conversationId);
      let conversationExists = firestore.exists(conversationPath);
      let conversation = conversationExists ? firestore.get(conversationPath).data : {};
      return isOwner(sponsorId)
        && conversationExists
        && conversation.get('sponsorId', '') == sponsorId;
    }

    function isTournamentSubmissionOwner(tournamentId, participantId) {
      let participantPath = /databases/(default)/documents/tournamentParticipants/$(tournamentId + '_' + request.auth.uid);
      let membershipPath = /databases/(default)/documents/tournamentTeamMemberships/$(tournamentId + '_' + request.auth.uid);
      return signedIn()
        && ((participantId == tournamentId + '_' + request.auth.uid
            && firestore.exists(participantPath)
            && firestore.get(participantPath).data.get('status', '') in ['registered', 'checked_in', 'active'])
          || (firestore.exists(membershipPath)
            && firestore.get(membershipPath).data.get('teamId', '') == participantId
            && firestore.get(membershipPath).data.get('role', '') == 'captain'
            && firestore.get(membershipPath).data.get('status', '') == 'active'));
    }

    function canWriteTournamentSubmissionMedia(folder) {
      return (folder == 'images' && isImage())
        || (folder == 'videos' && isVideo());
    }

    function isMedia() {
      return isImage() || isVideo();
    }

    function isSupportAttachment() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
    }

    match /challenges/drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && canWriteChallengeDraftMedia(folder);
    }

    match /challenges/host-drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && canWriteChallengeDraftMedia(folder);
    }

    match /challenges/hybrid-drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && canWriteChallengeDraftMedia(folder);
    }

    match /challenges/{challengeId}/banner/{fileName} {
      allow read: if isStoredImage() && isPublicChallengeBanner(challengeId, fileName)
        || isPublicPrivatePreviewBanner(challengeId, fileName)
        || (signedIn() && canReadChallengeMedia(challengeId));
      allow write: if isChallengeManager(challengeId) && ((resource == null && isCreatorImage()) || request.resource == null);
    }

    match /challenges/{challengeId}/trailers/{fileName} {
      allow read: if signedIn() && canReadChallengeMedia(challengeId);
      allow write: if isChallengeManager(challengeId) && ((resource == null && isVideo()) || request.resource == null);
    }

    match /challenges/{challengeId}/promo-flyer/{fileName} {
      allow read: if signedIn() && canReadChallengeMedia(challengeId);
      allow write: if isChallengeManager(challengeId) && ((resource == null && isCreatorImage()) || request.resource == null);
    }

    match /challenges/{challengeId}/promo-video/{fileName} {
      allow read: if signedIn() && canReadChallengeMedia(challengeId);
      allow write: if isChallengeManager(challengeId) && ((resource == null && isVideo()) || request.resource == null);
    }

    // Verified challenge media is delivered through the authorized application
    // media endpoint. Direct SDK reads use the same bounded rule checks; writes
    // remain server-only so Firebase download-token URLs are never required.
    match /verified-challenge-media/{challengeId}/{mediaKind}/{fileName} {
      allow read: if canReadVerifiedChallengeMedia(challengeId, mediaKind, fileName);
      allow write: if false;
    }

    match /challenges/{challengeId}/submissions/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isChallengeManager(challengeId);
      allow write: if isOwner(userId)
        && ((folder == 'images' && isImage())
          || (folder == 'videos' && isVideo())
          || (folder == 'documents' && isDocument()));
    }

    match /tournaments/drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && canWriteTournamentDraftMedia(folder);
    }

    match /tournaments/{tournamentId}/rounds/{roundId}/matches/{matchId}/participants/{participantId}/{folder}/{fileName} {
      allow read: if isTournamentSubmissionOwner(tournamentId, participantId);
      allow write: if isTournamentSubmissionOwner(tournamentId, participantId)
        && canWriteTournamentSubmissionMedia(folder);
    }

    match /live-events/drafts/{userId}/media/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && (isCreatorImage() || isVideo());
    }

    match /live-events/hybrid-drafts/{userId}/media/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && (isCreatorImage() || isVideo());
    }

    match /live-events/{eventId}/media/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin() && isMedia();
    }

    match /users/{userId}/profile/{folder}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage();
    }

    match /users/{userId}/support/{uploadId}/{fileName} {
      // Support files stay private and quarantined until a configured scanner
      // marks the ticket attachment cleared. All downloads use the server
      // endpoint, which checks ticket ownership and scan state.
      allow read: if false;
      allow write: if isOwner(userId) && (isSupportAttachment() || request.resource == null);
    }

    match /sponsors/{sponsorId}/{folder}/{fileName} {
      allow read: if isOwner(sponsorId) || isAdmin();
      allow write: if isOwner(sponsorId)
        && folder in ['logo', 'banner']
        && isImage();
    }

    match /sponsors/{sponsorId}/assets/{folder}/{fileName} {
      allow read: if isOwner(sponsorId) || isAdmin();
      allow write: if isOwner(sponsorId) && isImage();
    }

    match /sponsor-conversations/{conversationId}/{sponsorId}/{folder}/{fileName} {
      allow read: if canReadSponsorConversation(conversationId);
      allow write: if canWriteSponsorConversation(conversationId, sponsorId)
        && ((folder == 'images' && isImage())
          || (folder == 'documents' && isDocument()));
    }

    match /admin/public-content/{assetType}/{fileName} {
      allow read: if isActiveAdminUser();
      allow write: if isActiveAdminUser()
        && ((assetType == 'hero-poster' && isImage())
          || (assetType == 'hero-video' && isVideo()));
    }

    match /rewardPrizeMedia/{prizeId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin() && isImage();
    }

    match /users/{userId}/identity-documents/{fileName} {
      // KYC document processing is intentionally inactive; raw ID and face media must not be stored here.
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
