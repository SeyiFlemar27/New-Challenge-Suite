rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && ('admin' in request.auth.token) && request.auth.token.admin == true;
    }

    function isActiveAdminUser() {
      return signedIn()
        && isActiveAdminUserProfile(request.auth.uid, request.auth.token.get('admin', false) == true);
    }

    function isActiveAdminUserProfile(userId, tokenIsAdmin) {
      let userPath = /databases/(default)/documents/users/$(userId);
      return firestore.exists(userPath)
        ? isActiveAdminProfile(firestore.get(userPath).data)
        : tokenIsAdmin;
    }

    function isActiveAdminProfile(profile) {
      let assignments = profile.get('adminRoles', []);
      let expiresAt = profile.get('adminAccessExpiresAt', null);
      return (request.auth.token.get('admin', false) == true
          || profile.get('isAdmin', false) == true
          || profile.get('adminRole', '') == 'admin'
          || (assignments is list && assignments.hasAny([
            'admin', 'platform_owner', 'super_admin', 'operations_admin',
            'finance_admin', 'moderation_admin', 'safety_admin', 'support_admin',
            'sponsor_manager', 'event_tournament_admin', 'content_admin',
            'marketing_communications_admin', 'analyst', 'read_only_auditor',
            'technical_admin', 'developer_support'
          ])))
        && profile.get('adminAccessStatus', 'legacy_active') in ['active', 'legacy_active']
        && profile.get('adminSecuritySetupComplete', true) != false
        && (expiresAt == null
          || (expiresAt is timestamp && request.time < expiresAt)
          || (expiresAt is int && request.time.toMillis() < expiresAt));
    }

    function isChallengeManager(challengeId) {
      let challengePath = /databases/(default)/documents/challenges/$(challengeId);
      return signedIn()
        && (isAdmin()
          || (firestore.exists(challengePath)
            && firestore.get(challengePath).data.get('officialChallenge', false) != true
            && firestore.get(challengePath).data.get('ownershipType', '') != 'challenge_suite_official'
            && firestore.get(challengePath).data.creatorId == request.auth.uid)
          || isEnterpriseChallengeManager(challengeId));
    }

    function isPrivateChallenge(challenge) {
      return challenge.visibility == 'private'
        || challenge.visibility == 'exclusive'
        || challenge.type == 'Private / Exclusive'
        || challenge.type == 'private'
        || challenge.type == 'exclusive';
    }

    function hasApprovedPrivateAccess(challengeId) {
      let accessPath = /databases/(default)/documents/privateChallengeAccess/$(challengeId + '_' + request.auth.uid);
      return firestore.exists(accessPath) && firestore.get(accessPath).data.status == 'approved';
    }

    function hasPrivateChallengeParticipation(challengeId) {
      let participantPath = /databases/(default)/documents/challengeParticipants/$(challengeId + '_' + request.auth.uid);
      return firestore.exists(participantPath)
        && firestore.get(participantPath).data.status in ['registered', 'approved', 'active', 'entered', 'enrolled', 'winner'];
    }

    function isPublicPrivatePreview(challenge) {
      return challenge.visibility == 'private'
        && challenge.publicPreviewEnabled == true
        && challenge.get('publicVisibility', true) != false
        && challenge.get('eventVisibility', '') != 'hidden_until_approved'
        && challenge.status in ['published', 'approved', 'scheduled', 'registration_open', 'active'];
    }

    function canReadChallengeMedia(challengeId, allowPublicPreview) {
      let challengePath = /databases/(default)/documents/challenges/$(challengeId);
      return isAdmin()
        || (firestore.exists(challengePath)
          && (!isPrivateChallenge(firestore.get(challengePath).data)
            || isChallengeManager(challengeId)
            || (allowPublicPreview && isPublicPrivatePreview(firestore.get(challengePath).data))
            || hasApprovedPrivateAccess(challengeId)
            || hasPrivateChallengeParticipation(challengeId)));
    }

    function isEnterpriseChallengeManager(challengeId) {
      let challengePath = /databases/(default)/documents/challenges/$(challengeId);
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      return signedIn()
        && firestore.exists(challengePath)
        && firestore.exists(userPath)
        && firestore.get(challengePath).data.officialChallenge == true
        && firestore.get(challengePath).data.organizationOwnerId is string
        && firestore.get(userPath).data.staffAccess.status == 'active'
        && firestore.get(userPath).data.staffAccess.organizationId == firestore.get(challengePath).data.organizationOwnerId
        && firestore.get(userPath).data.staffAccess.permissions.hasAny(['challenge.edit'])
        && (firestore.get(userPath).data.staffAccess.expiresAtTimestamp == null
          || request.time < firestore.get(userPath).data.staffAccess.expiresAtTimestamp)
        && firestore.exists(/databases/(default)/documents/enterpriseOrganizations/$(firestore.get(challengePath).data.organizationOwnerId))
        && firestore.get(/databases/(default)/documents/enterpriseOrganizations/$(firestore.get(challengePath).data.organizationOwnerId)).data.status == 'active'
        && (firestore.get(userPath).data.staffAccess.scope == 'all_official'
          || (firestore.get(userPath).data.staffAccess.scope in ['assigned_only', 'read_all_edit_assigned']
            && firestore.get(challengePath).data.enterpriseAssignedUserIds is list
            && firestore.get(challengePath).data.enterpriseAssignedUserIds.hasAny([request.auth.uid])));
    }

    function isImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isVideo() {
      return request.resource != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType in ['video/mp4', 'video/avi', 'video/x-msvideo'];
    }

    function isDocument() {
      return request.resource != null
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'text/plain'
        ];
    }

    function canWriteChallengeDraftMedia(folder) {
      return (folder in ['banner', 'gallery'] && isImage())
        || (folder == 'video' && isVideo())
        || (folder == 'documents' && isDocument());
    }

    function canWriteTournamentDraftMedia(folder) {
      return (folder == 'cover' && isImage())
        || (folder == 'trailer' && isVideo());
    }

    function canReadSponsorConversation(conversationId) {
      let conversationPath = /databases/(default)/documents/sponsorConversations/$(conversationId);
      return isActiveAdminUser()
        || (signedIn()
          && firestore.exists(conversationPath)
          && (firestore.get(conversationPath).data.get('sponsorId', '') == request.auth.uid
            || firestore.get(conversationPath).data.get('recipientId', '') == request.auth.uid));
    }

    function canWriteSponsorConversation(conversationId, sponsorId) {
      let conversationPath = /databases/(default)/documents/sponsorConversations/$(conversationId);
      return isOwner(sponsorId)
        && firestore.exists(conversationPath)
        && firestore.get(conversationPath).data.get('sponsorId', '') == sponsorId;
    }

    function isTournamentSubmissionOwner(tournamentId, participantId) {
      let participantPath = /databases/(default)/documents/tournamentParticipants/$(tournamentId + '_' + request.auth.uid);
      let membershipPath = /databases/(default)/documents/tournamentTeamMemberships/$(tournamentId + '_' + request.auth.uid);
      return signedIn()
        && ((participantId == tournamentId + '_' + request.auth.uid
            && firestore.exists(participantPath)
            && firestore.get(participantPath).data.get('status', '') in ['registered', 'checked_in', 'active'])
          || (firestore.exists(membershipPath)
            && firestore.get(membershipPath).data.get('teamId', '') == participantId
            && firestore.get(membershipPath).data.get('role', '') == 'captain'
            && firestore.get(membershipPath).data.get('status', '') == 'active'));
    }

    function canWriteTournamentSubmissionMedia(folder) {
      return (folder == 'images' && isImage())
        || (folder == 'videos' && isVideo());
    }

    function isMedia() {
      return isImage() || isVideo();
    }

    function isSupportAttachment() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
    }

    match /challenges/drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && canWriteChallengeDraftMedia(folder);
    }

    match /challenges/host-drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && canWriteChallengeDraftMedia(folder);
    }

    match /challenges/hybrid-drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && canWriteChallengeDraftMedia(folder);
    }

    match /challenges/{challengeId}/banner/{fileName} {
      allow read: if signedIn() && canReadChallengeMedia(challengeId, true);
      allow write: if isChallengeManager(challengeId) && ((resource == null && isImage()) || request.resource == null);
    }

    match /challenges/{challengeId}/trailers/{fileName} {
      allow read: if signedIn() && canReadChallengeMedia(challengeId, false);
      allow write: if isChallengeManager(challengeId) && ((resource == null && isVideo()) || request.resource == null);
    }

    match /challenges/{challengeId}/promo-flyer/{fileName} {
      allow read: if signedIn() && canReadChallengeMedia(challengeId, false);
      allow write: if isChallengeManager(challengeId) && ((resource == null && isImage()) || request.resource == null);
    }

    match /challenges/{challengeId}/promo-video/{fileName} {
      allow read: if signedIn() && canReadChallengeMedia(challengeId, false);
      allow write: if isChallengeManager(challengeId) && ((resource == null && isVideo()) || request.resource == null);
    }

    match /challenges/{challengeId}/submissions/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isChallengeManager(challengeId);
      allow write: if isOwner(userId)
        && ((folder == 'images' && isImage())
          || (folder == 'videos' && isVideo())
          || (folder == 'documents' && isDocument()));
    }

    match /tournaments/drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && canWriteTournamentDraftMedia(folder);
    }

    match /tournaments/{tournamentId}/rounds/{roundId}/matches/{matchId}/participants/{participantId}/{folder}/{fileName} {
      allow read: if isTournamentSubmissionOwner(tournamentId, participantId);
      allow write: if isTournamentSubmissionOwner(tournamentId, participantId)
        && canWriteTournamentSubmissionMedia(folder);
    }

    match /live-events/drafts/{userId}/media/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isMedia();
    }

    match /live-events/hybrid-drafts/{userId}/media/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isMedia();
    }

    match /live-events/{eventId}/media/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin() && isMedia();
    }

    match /users/{userId}/profile/{folder}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage();
    }

    match /users/{userId}/support/{uploadId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && (isSupportAttachment() || request.resource == null);
    }

    match /sponsors/{sponsorId}/{folder}/{fileName} {
      allow read: if isOwner(sponsorId) || isAdmin();
      allow write: if isOwner(sponsorId)
        && folder in ['logo', 'banner']
        && isImage();
    }

    match /sponsors/{sponsorId}/assets/{folder}/{fileName} {
      allow read: if isOwner(sponsorId) || isAdmin();
      allow write: if isOwner(sponsorId) && isImage();
    }

    match /sponsor-conversations/{conversationId}/{sponsorId}/{folder}/{fileName} {
      allow read: if canReadSponsorConversation(conversationId);
      allow write: if canWriteSponsorConversation(conversationId, sponsorId)
        && ((folder == 'images' && isImage())
          || (folder == 'documents' && isDocument()));
    }

    match /admin/public-content/{assetType}/{fileName} {
      allow read: if isActiveAdminUser();
      allow write: if isActiveAdminUser()
        && ((assetType == 'hero-poster' && isImage())
          || (assetType == 'hero-video' && isVideo()));
    }

    match /rewardPrizeMedia/{prizeId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin() && isImage();
    }

    match /users/{userId}/identity-documents/{fileName} {
      // KYC document processing is intentionally inactive; raw ID and face media must not be stored here.
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
