rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource != null
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isVideo() {
      return request.resource != null
        && request.resource.size <= 250 * 1024 * 1024
        && request.resource.contentType in ['video/mp4', 'video/webm', 'video/quicktime'];
    }

    function isMedia() {
      return isImage() || isVideo();
    }

    match /challengeMedia/{challengeId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId) && isMedia();
    }

    match /challengeMedia/drafts/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isMedia();
    }

    match /challengeMedia/drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isMedia();
    }

    match /challengeMedia/host-drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isMedia();
    }

    match /submissions/{challengeId}/{userId}/{fileName} {
      // Submission media is authenticated-only until the server marks the submission approved and serves public-safe URLs.
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isMedia();
    }

    match /sponsorMedia/profile/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isImage();
    }

    match /sponsorMedia/{sponsorId}/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isImage();
    }

    match /profileMedia/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage();
    }

    match /profileMedia/{userId}/{folder}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage();
    }

    match /rewardPrizeMedia/{prizeId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin() && isImage();
    }

    match /eventMedia/{eventId}/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isMedia();
    }

    match /eventMedia/host-drafts/{userId}/{folder}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isMedia();
    }

    match /users/{userId}/identity-documents/{fileName} {
      // KYC document processing is intentionally inactive; raw ID and face media must not be stored here.
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

