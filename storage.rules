rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    match /users/{userId}/submissions/{fileName} {
      // Submission media remains private until a server-side approval and signed-delivery flow exists.
      allow read, write: if false;
    }

    match /users/{userId}/challenge-media/{fileName} {
      // Challenge media uploads are disabled until the production bucket and moderation flow are verified.
      allow read, write: if false;
    }

    match /users/{userId}/identity-documents/{fileName} {
      // KYC document processing is intentionally inactive.
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
