rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /legalDocumentVersions/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /userConsents/{consentId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow write: if false;
    }

    match /profiles/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow write: if false;
    }

    match /doroCoinWallets/{userId} {
      allow read, write: if false;
    }

    match /doroCoinTransactions/{transactionId} {
      allow read, write: if false;
    }

    match /votes/{voteId} {
      allow read, write: if false;
    }

    match /challenges/{challengeId} {
      // Public challenge data is served through a server API that applies a field allowlist.
      allow read, write: if false;
    }

    match /challengeParticipants/{participantId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /submissions/{submissionId} {
      // Public approved submissions are served through a server API after challenge checks.
      allow read, write: if false;
    }

    match /boosts/{boostId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /sponsorships/{sponsorshipId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /eventRegistrations/{registrationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /winnerClaims/{claimId} {
      allow read, write: if false;
    }

    match /notificationPreferences/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow write: if false;
    }

    match /subscriptionEvents/{eventId} {
      allow read, write: if false;
    }

    match /stripeSubscriptions/{document=**} {
      allow read, write: if false;
    }

    match /subscriptions/{document=**} {
      allow read, write: if false;
    }

    match /stripeWebhookEvents/{document=**} {
      allow read, write: if false;
    }

    match /webhookEvents/{document=**} {
      allow read, write: if false;
    }

    match /paymentEvents/{document=**} {
      allow read, write: if false;
    }

    match /sponsorshipPayments/{document=**} {
      allow read, write: if false;
    }

    match /cashWallets/{document=**} {
      allow read, write: if false;
    }

    match /cashTransactions/{document=**} {
      allow read, write: if false;
    }

    match /cashLedger/{document=**} {
      allow read, write: if false;
    }

    match /withdrawalRequests/{document=**} {
      allow read, write: if false;
    }

    match /payoutMethods/{document=**} {
      allow read, write: if false;
    }

    match /payouts/{document=**} {
      allow read, write: if false;
    }

    match /refunds/{document=**} {
      allow read, write: if false;
    }

    match /disputes/{document=**} {
      allow read, write: if false;
    }

    match /auditLogs/{document=**} {
      allow read, write: if false;
    }

    match /prizePools/{document=**} {
      allow read, write: if false;
    }

    match /adminActions/{actionId} {
      allow read, write: if false;
    }

    match /adminNotes/{document=**} {
      allow read, write: if false;
    }

    match /sponsorProfiles/{document=**} {
      allow read, write: if false;
    }

    match /fraudFlags/{flagId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /mediaUploads/{uploadId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /leaderboards/{leaderboardId} {
      allow read, write: if false;
    }

    match /winners/{winnerId} {
      allow read, write: if false;
    }

    match /adminAuditLogs/{document=**} {
      allow read, write: if false;
    }

    match /challengeEngagements/{document=**} {
      allow read, write: if false;
    }

    match /savedChallenges/{document=**} {
      allow read, write: if false;
    }

    match /hostWorkspaces/{document=**} {
      allow read, write: if false;
    }

    match /supportTickets/{document=**} {
      allow read, write: if false;
    }

    match /voteRequests/{document=**} {
      allow read, write: if false;
    }

    match /sumsubWebhookEvents/{document=**} {
      allow read, write: if false;
    }

    match /kycMetadata/{document=**} {
      allow read, write: if false;
    }

    match /revenueShareLedgers/{document=**} {
      allow read, write: if false;
    }

    match /privateChallengeInvites/{document=**} {
      allow read, write: if false;
    }

    match /privateChallengeAccess/{document=**} {
      allow read, write: if false;
    }

    match /privateInviteAuditEvents/{document=**} {
      allow read, write: if false;
    }

    match /predictionRecords/{document=**} {
      allow read, write: if false;
    }

    match /predictionSettlementReviews/{document=**} {
      allow read, write: if false;
    }

    match /predictionRefundReviews/{document=**} {
      allow read, write: if false;
    }

    match /rewardWheelPrizes/{document=**} {
      allow read, write: if false;
    }

    match /rewardSpinHistory/{document=**} {
      allow read, write: if false;
    }

    match /rewardFulfillments/{document=**} {
      allow read, write: if false;
    }

    match /spinCredits/{document=**} {
      allow read, write: if false;
    }

    match /rewardPointEvents/{document=**} {
      allow read, write: if false;
    }

    match /rewardSettings/{document=**} {
      allow read, write: if false;
    }

    match /rewardCampaigns/{document=**} {
      allow read, write: if false;
    }

    match /rewardPrizes/{document=**} {
      allow read, write: if false;
    }

    match /userRewards/{document=**} {
      allow read, write: if false;
    }

    match /spinResults/{document=**} {
      allow read, write: if false;
    }

    match /rewardClaims/{document=**} {
      allow read, write: if false;
    }

    match /rewardFulfilments/{document=**} {
      allow read, write: if false;
    }

    match /rewardAuditLogs/{document=**} {
      allow read, write: if false;
    }

    match /rewardDailySpinUsage/{document=**} {
      allow read, write: if false;
    }

    match /rewardUserSpinUsage/{document=**} {
      allow read, write: if false;
    }

    match /voterRewardEvents/{document=**} {
      allow read, write: if false;
    }

    match /adVoteRewardLogs/{document=**} {
      allow read, write: if false;
    }

    match /enterpriseInquiries/{document=**} {
      allow read, write: if false;
    }

    match /featureFlags/{document=**} {
      allow read, write: if false;
    }

    match /tournamentPlans/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

