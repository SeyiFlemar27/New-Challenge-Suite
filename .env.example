NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK service account credentials.
# Required for all server API reads/writes.
# In local .env files, keep newline characters escaped as \n.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional but recommended for Admin SDK health checks/uploads. Use the exact bucket name from Firebase Storage, without gs://.
# This may differ from NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET in newer Firebase projects.
FIREBASE_STORAGE_BUCKET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Local development only. When Stripe env vars are blank, checkout routes return a mock internal URL and process no payment.
STRIPE_ENABLE_DEV_MOCK_CHECKOUT=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INITIAL_ADMIN_EMAILS=

# Subscription Stripe price IDs
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_COMPETITOR=
STRIPE_PRICE_EXECUTIVE_HOST=
STRIPE_PRICE_CHIEF_PRODUCER=
STRIPE_PRICE_BRAND_PARTNER=
STRIPE_PRICE_ENTERPRISE_SPONSOR=
# Blueprint/test aliases also supported. Leave blank until real Stripe test price IDs exist.
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_HOST_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_SPONSOR_STARTER_PRICE_ID=
STRIPE_BRAND_PARTNER_PRICE_ID=
STRIPE_ENTERPRISE_PARTNER_PRICE_ID=

# DoroCoin package Stripe price IDs
STRIPE_PRICE_DOROCOIN_50=
STRIPE_PRICE_DOROCOIN_100=
STRIPE_PRICE_DOROCOIN_500=
# DoroCoin test aliases also supported.
STRIPE_DOROCOIN_SMALL_PRICE_ID=
STRIPE_DOROCOIN_MEDIUM_PRICE_ID=
STRIPE_DOROCOIN_LARGE_PRICE_ID=

# Email OTP verification
# Generate a long random value for OTP_HASH_SECRET.
OTP_HASH_SECRET=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Challenge Suite <verify@your-domain.com>"

# Firestore seed script
# Required for real seed runs: NEXT_PUBLIC_FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY.
# Optional: target an existing Firebase Auth UID for demo wallet, badge, and notification records.
SEED_USER_ID=
DEMO_USER_ID=
